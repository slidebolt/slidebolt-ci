pipeline {
  agent { label 'slidebolt || built-in' }
  options { timestamps(); timeout(time: 120, unit: 'MINUTES'); disableConcurrentBuilds() }
  parameters {
    string(name: 'RELEASE_VERSION', description: 'New v-prefixed release version')
    string(name: 'CANDIDATE_BUILD', description: 'Successful slidebolt-candidate build number')
    string(name: 'CONFIRM_VERSION', description: 'Repeat RELEASE_VERSION to authorize publication')
    string(name: 'CANDIDATE_JOB', defaultValue: '/Slidebolt/release/candidate', description: 'Candidate job containing the fingerprinted proof')
  }
  stages {
    stage('Load verified candidate') {
      steps {
        copyArtifacts(
          projectName: params.CANDIDATE_JOB,
          selector: specific(params.CANDIDATE_BUILD),
          filter: 'candidate-proof.json',
          fingerprintArtifacts: true
        )
      }
    }
    stage('Safety interlock') {
      steps {
        sh '''
          test "$RELEASE_VERSION" = "$CONFIRM_VERSION"
          printf '%s' "$RELEASE_VERSION" | grep -Eq '^v[0-9]+[.][0-9]+[.][0-9]+$'
          test "$(jq -r .candidateBuild candidate-proof.json)" = "$CANDIDATE_BUILD"
          test "$(jq -r .schemaVersion candidate-proof.json)" = "1"
          test "$(jq -r .releaseCommit candidate-proof.json)" != "null"
          test "$(jq -r .ciCommit candidate-proof.json)" = "$(git rev-parse HEAD)"
        '''
      }
    }
    stage('Reverify and publish') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'github-release-publisher', usernameVariable: 'GITHUB_PUBLISHER_USER', passwordVariable: 'GITHUB_RELEASE_TOKEN'),
          string(credentialsId: 'github-read-token', variable: 'GITHUB_READ_TOKEN')
        ]) {
          sh 'scripts/promote-slidebolt.sh "$RELEASE_VERSION" candidate-proof.json'
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: 'promotion/**/*'
      cleanWs(deleteDirs: true)
    }
  }
}

