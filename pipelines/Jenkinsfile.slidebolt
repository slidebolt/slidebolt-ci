pipeline {
  agent any
  options { timestamps(); timeout(time: 90, unit: 'MINUTES'); disableConcurrentBuilds() }
  parameters {
    string(name: 'RELEASE_REF', defaultValue: 'v1.0.64', description: 'Existing release tag to reproduce')
  }
  stages {
    stage('Verify environment') {
      steps { sh 'docker version && docker compose version && go version' }
    }
    stage('Reproduce SlideBolt') {
      steps { sh 'scripts/verify-slidebolt.sh "$RELEASE_REF"' }
    }
  }
  post {
    always {
      junit allowEmptyResults: true, testResults: 'work/sb-e2e/artifacts/**/*.xml'
      archiveArtifacts allowEmptyArchive: true, artifacts: 'work/sb-e2e/artifacts/**/*'
      cleanWs(deleteDirs: true)
    }
  }
}

